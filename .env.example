# Before (claims_intake_agent.py): the agent holds a provider key.
ANTHROPIC_API_KEY=sk-ant-...

# After, Fabric (solutions/fabric/claims_intake_agent.py): the agent holds only a gateway key.
# These are the same two variables you set in Introduction to Fabric, Lesson 6.
FABRIC_GATEWAY_URL=https://<gateway-subdomain>.dp.fabricgateway.ai/anthropic
FABRIC_GATEWAY_KEY=<gateway-key>

# After, Passport (solutions/passport/claims_intake_agent.py): no variables.
# The agent sends the reference {{vault:ANTHROPIC_API_KEY}} and the Passport Proxy adds the real key.
# Run `unset ANTHROPIC_API_KEY` first so the old key can't be used by accident.
